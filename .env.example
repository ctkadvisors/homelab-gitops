# Local AI Stack Environment Configuration
# Copy this to .env and customize for your environment

# Cluster Configuration
CLUSTER_NAME=localai
DOMAIN=example.com

# Network Configuration
SUBNET=192.168.131.0/24

# Model Configuration
DEFAULT_MODEL=mistral:7b-instruct
OLLAMA_KEEP_ALIVE=30m

# Monitoring
PROMETHEUS_RETENTION=30d
GRAFANA_ADMIN_PASSWORD=REDACTED

# Security
JWT_SECRET=REDACTED
TAILSCALE_AUTHKEY=  # Add your Tailscale auth key here

# K3s Configuration
KUBECONFIG=./kubeconfig
K3S_TOKEN=REDACTED

# Node IPs (for reference)
JETSON1_IP=192.168.131.123
JETSON2_IP=192.168.131.163
ELITEMINI_IP=192.168.131.111
ELITEMINI2_IP=192.168.131.209
