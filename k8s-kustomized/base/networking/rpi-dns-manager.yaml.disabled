# DISABLED - RPi removed from network (raspberrypi1 is NotReady)
# This file managed DNS configuration on the RPi node which has been removed
# DNS now handled by external providers (8.8.8.8, 1.1.1.1)
# Original file moved to .disabled to preserve configuration history

# If you re-add a dedicated DNS server node, you can reference this configuration
# and update the IP addresses accordingly

---
# RPi DNS Configuration Manager - DISABLED
# Previously managed DNS configuration on raspberrypi1 (192.168.131.101)
apiVersion: v1
kind: ConfigMap
metadata:
  name: rpi-dns-config-disabled
  namespace: kube-system
  labels:
    app.kubernetes.io/name: rpi-dns-manager
    app.kubernetes.io/component: dns-config
    status: disabled
data:
  README: |
    This DNS configuration has been disabled because raspberrypi1 
    has been removed from the network.
    
    The cluster now uses external DNS servers:
    - 8.8.8.8 (Google DNS)
    - 1.1.1.1 (Cloudflare DNS)
    
    If you want to re-enable local DNS management:
    1. Add a new DNS server node to the cluster
    2. Update the IP addresses in this configuration
    3. Rename this file back to rpi-dns-manager.yaml
    4. Update the networking kustomization to include it