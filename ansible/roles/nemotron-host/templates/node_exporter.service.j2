[Unit]
Description=Prometheus Node Exporter
After=network-online.target
Wants=network-online.target

[Service]
User=node_exporter
Group=node_exporter
Type=simple
ExecStart=/usr/local/bin/node_exporter --collector.disable-defaults --collector.textfile --collector.textfile.directory=/var/lib/node_exporter/textfile_collector {{ node_exporter_collectors | map('regex_replace', '^', '--collector.') | join(' ') }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
