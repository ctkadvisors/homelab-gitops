# Journal configuration for Local AI Homelab
# Generated by Ansible - DO NOT EDIT MANUALLY

[Journal]
# Storage configuration
Storage=persistent
Compress=yes
Seal=yes

# Size limits
SystemMaxUse={{ log_management.journald.max_use }}
SystemKeepFree=1G
SystemMaxFileSize={{ log_management.journald.max_file_size }}
SystemMaxFiles=100

# Runtime limits
RuntimeMaxUse=100M
RuntimeKeepFree=100M
RuntimeMaxFileSize=10M
RuntimeMaxFiles=10

# Retention
MaxRetentionSec={{ log_management.journald.max_retention_sec }}
MaxFileSec=1day

# Rate limiting
RateLimitInterval=30s
RateLimitBurst=1000

# Forward to syslog
ForwardToSyslog=yes
ForwardToKMsg=no
ForwardToConsole=no
ForwardToWall=yes

# TTY settings
TTYPath=/dev/console
MaxLevelStore=info
MaxLevelSyslog=info
MaxLevelKMsg=notice
MaxLevelConsole=info
MaxLevelWall=emerg
