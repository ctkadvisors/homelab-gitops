# System Information for {{ inventory_hostname }}
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

[System]
Hostname={{ inventory_hostname }}
FQDN={{ ansible_fqdn }}
Distribution={{ ansible_distribution }} {{ ansible_distribution_version }}
Kernel={{ ansible_kernel }}
Architecture={{ ansible_architecture }}
Virtualization={{ ansible_virtualization_type | default('physical') }}

[Hardware]
CPU_Model={{ ansible_processor[2] | default('Unknown') }}
CPU_Cores={{ ansible_processor_vcpus }}
CPU_Threads={{ ansible_processor_threads_per_core | default(1) }}
Memory_Total={{ ansible_memtotal_mb }}MB
Memory_Free={{ ansible_memfree_mb }}MB
Swap_Total={{ ansible_swaptotal_mb }}MB

[Network]
Primary_Interface={{ ansible_default_ipv4.interface }}
Primary_IP={{ ansible_default_ipv4.address }}
Gateway={{ ansible_default_ipv4.gateway }}
DNS_Servers={{ ansible_dns.nameservers | join(', ') }}
MAC_Address={{ ansible_default_ipv4.macaddress }}

[Storage]
{% for device in ansible_devices %}
{% if ansible_devices[device].size is defined and ansible_devices[device].size != "0.00 Bytes" %}
{{ device }}={{ ansible_devices[device].size }} ({{ ansible_devices[device].model | default('Unknown') }})
{% endif %}
{% endfor %}

[Mounts]
{% for mount in ansible_mounts %}
{{ mount.mount }}={{ mount.size_total | filesizeformat }} ({{ mount.fstype }})
{% endfor %}

[Services]
K3s_Role={{ k3s_role | default('undefined') }}
Node_Type={{ node_type | default('undefined') }}
GPU_Enabled={{ gpu_enabled | default(false) }}

[Configuration]
Timezone={{ base_system.timezone }}
Locale={{ base_system.locale }}
SSH_Port={{ ssh_config.port }}
Firewall_Enabled={{ firewall_config.enabled }}

[Ansible]
Last_Updated={{ ansible_date_time.iso8601 }}
Ansible_Version={{ ansible_version.full }}
Python_Version={{ ansible_python_version }}

[Local AI Homelab]
Project={{ project_name }}
Version={{ project_version }}
Environment={{ deployment_environment }}
