# NVIDIA Container Runtime Information for {{ inventory_hostname }}
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

[NVIDIA Hardware]
GPU_Present=true
GPU_Driver_Version={{ nvidia_smi_check.stdout | regex_search('Driver Version: ([0-9.]+)', '\\1') | first | default('Unknown') }}

[NVIDIA Container Runtime]
Toolkit_Version={{ nvidia_ctk_version.stdout }}
Runtime_Enabled=true
Default_Runtime={{ nvidia_runtime.runtime_config.default_runtime }}

[Docker Integration]
Docker_Runtime_Configured=true
GPU_Access_Enabled=true
Runtime_Test_Status={{ 'PASSED' if nvidia_test_result is succeeded else 'FAILED' }}

[Configuration]
Runtime_Path={{ nvidia_runtime.runtime_config.runtimes.nvidia.path }}
Container_Toolkit_Installed=true

[Environment Variables]
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

[Last Updated]
Timestamp={{ ansible_date_time.iso8601 }}
Configured_By=Ansible
