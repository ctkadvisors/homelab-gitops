#!/bin/bash
# Jetson Thermal Monitoring Script
# Generated by Ansible - DO NOT EDIT MANUALLY

# Configuration
WARNING_TEMP={{ thermal_management.thresholds.warning }}
CRITICAL_TEMP={{ thermal_management.thresholds.critical }}
SHUTDOWN_TEMP={{ thermal_management.thresholds.shutdown }}

# Logging
LOG_FILE="/var/log/thermal-monitor.log"
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

# Function to log messages
log_message() {
    echo "[$TIMESTAMP] $1" >> "$LOG_FILE"
}

# Function to get temperature from thermal zone
get_temperature() {
    local zone="$1"
    if [ -f "/sys/class/thermal/$zone/temp" ]; then
        local temp_millidegrees=$(cat "/sys/class/thermal/$zone/temp")
        echo $((temp_millidegrees / 1000))
    else
        echo "0"
    fi
}

# Check each thermal zone
{% for zone in thermal_management.thermal_zones %}
TEMP_{{ loop.index }}=$(get_temperature "{{ zone }}")
{% endfor %}

# Find maximum temperature
MAX_TEMP=0
{% for zone in thermal_management.thermal_zones %}
if [ "$TEMP_{{ loop.index }}" -gt "$MAX_TEMP" ]; then
    MAX_TEMP=$TEMP_{{ loop.index }}
fi
{% endfor %}

# Temperature actions
if [ "$MAX_TEMP" -ge "$SHUTDOWN_TEMP" ]; then
    log_message "CRITICAL: Temperature $MAX_TEMP°C exceeds shutdown threshold. Initiating emergency shutdown."
    wall "EMERGENCY: System overheating ($MAX_TEMP°C). Shutting down in 30 seconds!"
    sleep 30
    shutdown -h now "Emergency shutdown due to overheating"
elif [ "$MAX_TEMP" -ge "$CRITICAL_TEMP" ]; then
    log_message "CRITICAL: Temperature $MAX_TEMP°C exceeds critical threshold."
    # Reduce performance
    echo "powersave" > /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor 2>/dev/null || true
    # Notify users
    wall "WARNING: System overheating ($MAX_TEMP°C). Performance reduced."
elif [ "$MAX_TEMP" -ge "$WARNING_TEMP" ]; then
    log_message "WARNING: Temperature $MAX_TEMP°C exceeds warning threshold."
else
    # Temperature is normal, ensure performance governor is set
    echo "performance" > /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor 2>/dev/null || true
fi

# Log current status (only if temperature is concerning)
if [ "$MAX_TEMP" -ge "$WARNING_TEMP" ]; then
    log_message "Current temperatures: {% for zone in thermal_management.thermal_zones %}{{ zone }}=${TEMP_{{ loop.index }}}°C {% endfor %}"
fi
