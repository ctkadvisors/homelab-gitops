#!/bin/bash
# K3s Cluster Backup Script
# Generated by Ansible - DO NOT EDIT MANUALLY

set -euo pipefail

# Configuration
BACKUP_DIR="{{ backup_config.backup_dir }}"
RETENTION_DAYS="{{ backup_config.retention_days }}"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_NAME="k3s-backup-${TIMESTAMP}"
BACKUP_PATH="${BACKUP_DIR}/${BACKUP_NAME}"

# Logging
LOG_FILE="${BACKUP_DIR}/backup.log"
exec 1> >(tee -a "${LOG_FILE}")
exec 2>&1

echo "=== K3s Backup Started at $(date) ==="

# Create backup directory
mkdir -p "${BACKUP_PATH}"

# Function to backup with error handling
backup_item() {
    local source="$1"
    local dest="$2"
    
    if [ -e "${source}" ]; then
        echo "Backing up ${source} to ${dest}"
        cp -r "${source}" "${dest}/" 2>/dev/null || {
            echo "Warning: Failed to backup ${source}"
            return 1
        }
    else
        echo "Warning: ${source} does not exist, skipping"
        return 1
    fi
}

# Stop K3s service for consistent backup
echo "Stopping K3s service for backup..."
systemctl stop k3s || {
    echo "Warning: Failed to stop K3s service"
}

# Backup K3s data
{% for item in backup_config.items %}
backup_item "{{ item }}" "${BACKUP_PATH}"
{% endfor %}

# Backup additional cluster information
echo "Backing up cluster information..."
if command -v k3s >/dev/null 2>&1; then
    # Export cluster resources (if K3s is available)
    mkdir -p "${BACKUP_PATH}/cluster-resources"
    
    # Try to get cluster info (may fail if cluster is down)
    k3s kubectl get all --all-namespaces -o yaml > "${BACKUP_PATH}/cluster-resources/all-resources.yaml" 2>/dev/null || {
        echo "Warning: Could not export cluster resources"
    }
    
    k3s kubectl get nodes -o yaml > "${BACKUP_PATH}/cluster-resources/nodes.yaml" 2>/dev/null || {
        echo "Warning: Could not export node information"
    }
fi

# Start K3s service
echo "Starting K3s service..."
systemctl start k3s || {
    echo "Error: Failed to start K3s service"
    exit 1
}

# Create compressed archive
echo "Creating compressed backup archive..."
cd "${BACKUP_DIR}"
tar -czf "${BACKUP_NAME}.tar.gz" "${BACKUP_NAME}/" && {
    rm -rf "${BACKUP_NAME}/"
    echo "Backup archive created: ${BACKUP_NAME}.tar.gz"
} || {
    echo "Error: Failed to create backup archive"
    exit 1
}

# Cleanup old backups
echo "Cleaning up old backups (older than ${RETENTION_DAYS} days)..."
find "${BACKUP_DIR}" -name "k3s-backup-*.tar.gz" -type f -mtime +${RETENTION_DAYS} -delete || {
    echo "Warning: Failed to cleanup old backups"
}

# Backup verification
if [ -f "${BACKUP_DIR}/${BACKUP_NAME}.tar.gz" ]; then
    BACKUP_SIZE=$(du -h "${BACKUP_DIR}/${BACKUP_NAME}.tar.gz" | cut -f1)
    echo "Backup completed successfully: ${BACKUP_NAME}.tar.gz (${BACKUP_SIZE})"
else
    echo "Error: Backup file not found"
    exit 1
fi

echo "=== K3s Backup Completed at $(date) ==="

# Optional: Send notification (implement as needed)
# curl -X POST -H 'Content-type: application/json' \
#   --data '{"text":"K3s backup completed: '${BACKUP_NAME}'.tar.gz"}' \
#   YOUR_WEBHOOK_URL
